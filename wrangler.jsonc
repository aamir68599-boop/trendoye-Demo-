{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silk-soul",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/products/*",
      "/admin",
      "/admin/"
    ]
